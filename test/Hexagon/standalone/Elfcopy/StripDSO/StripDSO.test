#---NonZeroVMa.test--------------------- Exe------------------#
#BEGIN_COMMENT
#When stripping shared libraries, make sure the VMA and LMA
#for the program headers are sane
#END_COMMENT
RUN: %clang %clangopts -c %p/Inputs/1.c %clangg0opts -fpic -g -o %t1.o
RUN: %link %linkopts -shared %t1.o -o %t.so
RUN: %link %linkopts -mtriple=hexagon-unknown-linux  -shared %t1.o -o %t.linux.so
RUN: %readelf -l %t.so | %python -c "import sys; print(''.join(line for line in sys.stdin if 'None' not in line), end='')" > %tunstripped
RUN: %strip %t.so
RUN: %readelf -l %t.so | %python -c "import sys; print(''.join(line for line in sys.stdin if 'None' not in line), end='')" > %tstripped
RUN: diff %tunstripped %tstripped
RUN: %readelf -l %t.linux.so | %python -c "import sys; print(''.join(line for line in sys.stdin if 'None' not in line), end='')" > %t.linux.unstripped
RUN: %strip %t.linux.so
RUN: %readelf -l %t.linux.so | %python -c "import sys; print(''.join(line for line in sys.stdin if 'None' not in line), end='')" > %t.linux.stripped
RUN: diff %t.linux.unstripped %t.linux.stripped
