## x86 hardcodes a PLT stub's relocation index in the stub's own pushq.
## This test checks that the index matches the symbol's position in .rela.plt.


# RUN: split-file %s %t
# RUN: %clang %clangopts -c -fPIC %t/lib.c -o %t/lib.o
# RUN: %clang %clangopts -c -fPIC %t/callsa.c -o %t/callsa.o
# RUN: %clang %clangopts -c -fPIC %t/callsb.c -o %t/callsb.o

# RUN: %link %linkopts -shared %t/lib.o -o %t/lib.so
# RUN: %link %linkopts -shared %t/callsa.o %t/callsb.o %t/lib.so -o %t/plt.so

# RUN: %readelf -rW %t/plt.so > %t/pltidx.txt
# RUN: %objdump -d --section=.plt %t/plt.so >> %t/pltidx.txt
# RUN: %filecheck %s --check-prefix=PLTIDX --input-file=%t/pltidx.txt

# PLTIDX: JUMP_SLOT {{.*}} [[S1:fn[0-9]]]
# PLTIDX: JUMP_SLOT {{.*}} [[S2:fn[0-9]]]
# PLTIDX: JUMP_SLOT {{.*}} [[S3:fn[0-9]]]
# PLTIDX: JUMP_SLOT {{.*}} [[S4:fn[0-9]]]
# PLTIDX: JUMP_SLOT {{.*}} [[S5:fn[0-9]]]
# PLTIDX: <[[S1]]@plt>:
# PLTIDX: pushq $0x0
# PLTIDX: <[[S2]]@plt>:
# PLTIDX: pushq $0x1
# PLTIDX: <[[S3]]@plt>:
# PLTIDX: pushq $0x2
# PLTIDX: <[[S4]]@plt>:
# PLTIDX: pushq $0x3
# PLTIDX: <[[S5]]@plt>:
# PLTIDX: pushq $0x4

#--- lib.c
int fn1(void) { return 1; }
int fn2(void) { return 2; }
int fn3(void) { return 3; }
int fn4(void) { return 4; }
int fn5(void) { return 5; }

#--- callsa.c
int fn1(void), fn2(void), fn3(void), fn4(void), fn5(void);
int ga(void) { return fn1() + fn3() + fn5(); }

#--- callsb.c
int fn1(void), fn2(void), fn3(void), fn4(void), fn5(void);
int gb(void) { return fn2() + fn4() + fn1(); }
