#----------DUPLICATE_ALIGN.test----------------- Executable------------------#
#BEGIN_COMMENT
# Two R_RISCV_ALIGN relocations reserving the same NOP-padding bytes must
# not crash the linker; report a diagnostic error instead.
#END_COMMENT
#--------------------------------------------------------------------
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/riscv-duplicate-align.s -o %t1.o
RUN: not %link %linkopts %t1.o -o %t1.out 2>&1 | %filecheck %s
#END_TEST

CHECK: Error: Duplicate or overlapping R_RISCV_ALIGN relocation in section .text+{{.+}} file {{.*}}DUPLICATE_ALIGN.test.tmp1.o
