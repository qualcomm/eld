#---EarlierRelocation.test---------------- Executable ----------------#
#BEGIN_COMMENT
# The immediately preceding SET, not the first relocation at the same offset,
# selects the ULEB128 pair tombstone. Preserve the existing no-option grouping.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -o %t1.1.o -c %p/Inputs/earlier.S
RUN: %link %linkopts -o %t1.base.out %t1.1.o -T %p/Inputs/layout.t -e _start --gc-sections
RUN: %readelf -x .debug_pairs_uleb %t1.base.out > %t1.base.txt
RUN: %filecheck %s --check-prefix=BASE < %t1.base.txt
RUN: %link %linkopts -o %t1.nomatch.out %t1.1.o -T %p/Inputs/layout.t -e _start --gc-sections -z dead-reloc-in-nonalloc=.no_match=0x42
RUN: %readelf -x .debug_pairs_uleb %t1.nomatch.out > %t1.nomatch.txt
RUN: %diff %t1.base.txt %t1.nomatch.txt
RUN: %link %linkopts -o %t1.override.out %t1.1.o -T %p/Inputs/layout.t -e _start --gc-sections -z dead-reloc-in-nonalloc=.debug_pairs_uleb=0x42
RUN: %readelf -x .debug_pairs_uleb %t1.override.out | %filecheck %s --check-prefix=OVERRIDE
RUN: %link %linkopts -o %t1.zero.out %t1.1.o -T %p/Inputs/layout.t -e _start --gc-sections -z dead-reloc-in-nonalloc=.debug_pairs_uleb=0
RUN: %readelf -x .debug_pairs_uleb %t1.zero.out | %filecheck %s --check-prefix=ZERO
#END_TEST

BASE: Hex dump of section '.debug_pairs_uleb':
BASE-NEXT: 0x00000000 90010000

OVERRIDE: Hex dump of section '.debug_pairs_uleb':
OVERRIDE-NEXT: 0x00000000 c2000000

ZERO: Hex dump of section '.debug_pairs_uleb':
ZERO-NEXT: 0x00000000 80000000
