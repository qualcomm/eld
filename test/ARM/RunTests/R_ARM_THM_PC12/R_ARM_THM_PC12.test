REQUIRES: run_test
#---R_ARM_THM_PC12.test--------------------- Executable------------------#
#BEGIN_COMMENT
# Test the ARM R_ARM_THM_PC12 relocation at runtime.
# Verifies that the relocation correctly encodes a Thumb-2 LDR literal
# and that the target value 42 can be loaded at runtime.
#END_COMMENT
#START_TEST
RUN: %run_cc -nostdlib -c -o %t.main.o %p/Inputs/main.s
RUN: %readelf -r %t.main.o | %filecheck %s --check-prefix RELOCS
RUN: %run_cc -c -o %t.driver.o %p/Inputs/main.c
RUN: %run_cc -static -o %t.static.out %t.main.o %t.driver.o
RUN: %run %t.static.out | %filecheck %s
RELOCS: R_ARM_THM_PC12 {{.*}} target
CHECK: target = 42
#END_TEST
