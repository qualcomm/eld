#---R_ARM_LDC_SB_G2_Error.test--------------- Executable ------------------#
#BEGIN_COMMENT
# Verify R_ARM_LDC_SB_G2 reports an error when the selected G2 residual
# cannot be encoded in the LDC/STC scaled 8-bit immediate.
#
# Overflow:
#   X = 0x4040400
#   G2 residual = 0x400 = 1024
#
# Unaligned:
#   X = 0x40402
#   G2 residual = 0x2, which is not 4-byte aligned.
#END_COMMENT
#START_TEST
RUN: %clangas -c %p/Inputs/overflow.s -o %t.overflow.o
RUN: %not %link %linkopts -march arm -static -T %p/Inputs/script.t %t.overflow.o -o %t.overflow.out 2>&1 | %filecheck %s --check-prefix=OVERFLOW

OVERFLOW: R_ARM_LDC_SB_G2 out of range: 1024 is not in [0, 1023]

RUN: %clangas -c %p/Inputs/unaligned.s -o %t.unaligned.o
RUN: %not %link %linkopts -march arm -static -T %p/Inputs/script.t %t.unaligned.o -o %t.unaligned.out 2>&1 | %filecheck %s --check-prefix=UNALIGNED

UNALIGNED: Relocation error when applying relocation `R_ARM_LDC_SB_G2'
#END_TEST
