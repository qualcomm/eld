#---R_ARM_LDC_PC_G0_Overflow.test------------ Executable ------------------#
#BEGIN_COMMENT
# Verify R_ARM_LDC_PC_G0 reports overflow when the selected group
# residual cannot fit in the LDC/STC scaled 8-bit immediate.
#
# X = 0x1000 = 4096, while the maximum accepted residual is 0x3ff.
#END_COMMENT
#START_TEST
RUN: %clangas -c %p/Inputs/overflow.s -o %t.o
RUN: %not %link %linkopts -march arm -static %t.o -o %t.out 2>&1 | %filecheck %s

CHECK: R_ARM_LDC_PC_G0 out of range: 4096 is not in [0, 1023]
#END_TEST
