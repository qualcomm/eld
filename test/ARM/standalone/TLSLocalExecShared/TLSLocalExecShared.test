#---TLSLocalExecShared.test---------------------- Shared Library --------------#
#BEGIN_COMMENT
# Verify that ARM TLS local-exec relocations are rejected when creating a
# shared library.
#END_COMMENT
#START_TEST

RUN: %clang %clangopts -ftls-model=local-exec -c %p/Inputs/tls.c \
RUN:   -o %t.tls.o
RUN: %not %link %linkopts -shared %t.tls.o -o %t.tls.so 2>&1 \
RUN:   | %filecheck %s --check-prefix=TLS

RUN: %clang %clangopts -ftls-model=local-exec -c %p/Inputs/tls_hidden.c \
RUN:   -o %t.hidden.o
RUN: %not %link %linkopts -shared %t.hidden.o -o %t.hidden.so 2>&1 \
RUN:   | %filecheck %s --check-prefix=HIDDEN

#END_TEST

TLS: Fatal: relocation R_ARM_TLS_LE32 against tls_var referred from {{.*}}tls.o{{.*}} cannot be used with -shared
HIDDEN: Fatal: relocation R_ARM_TLS_LE32 against hidden_tls_var referred from {{.*}}hidden.o{{.*}} cannot be used with -shared
