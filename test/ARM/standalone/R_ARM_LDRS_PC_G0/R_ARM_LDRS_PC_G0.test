#---R_ARM_LDRS_PC_G0.test--------------------- Executable ------------------#
#BEGIN_COMMENT
# Verify R_ARM_LDRS_PC_G0 relocation is correctly applied.
# Formula: ((S + A) | T) - P
# The sign is encoded in the U bit and the magnitude in imm4H:imm4L.
#END_COMMENT
#START_TEST
RUN: llvm-mc --triple=armv7a-none-eabi --arm-add-build-attributes \
RUN:   -filetype=obj %p/Inputs/main.s -o %t.o
RUN: %link %linkopts -march arm %t.o -o %t.out
RUN: %readelf -x .text %t.out | %filecheck %s

CHECK: d0014fe1 d001cfe1
#END_TEST
