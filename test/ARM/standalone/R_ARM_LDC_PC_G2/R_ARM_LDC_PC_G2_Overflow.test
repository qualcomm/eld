#---R_ARM_LDC_PC_G2_Overflow.test------------ Executable ------------------#
#BEGIN_COMMENT
# Verify R_ARM_LDC_PC_G2 reports overflow when the selected G2 residual
# cannot fit in the LDC/STC scaled 8-bit immediate.
#
# X = 0x04040400.
# G2 residual = 0x400 = 1024, which is outside [0, 1023].
#END_COMMENT
#START_TEST
RUN: %clangas -c %p/Inputs/overflow.s -o %t.range.o
RUN: %link %linkopts -march arm -T %p/Inputs/range.t %t.range.o -o %t.range.out
RUN: %readelf -x .text.1 %t.range.out | %filecheck %s --check-prefix=RANGE

RANGE: 0x00800000 ff019fed

RUN: %clangas -c %p/Inputs/overflow.s -o %t.o
RUN: %not %link %linkopts -march arm -T %p/Inputs/overflow.t %t.o -o %t.out 2>&1 | %filecheck %s

CHECK: R_ARM_LDC_PC_G2 out of range: 1024 is not in [0, 1023]
#END_TEST
