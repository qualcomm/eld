#---R_ARM_LDC_PC_G1.test--------------------- Executable ------------------#
#BEGIN_COMMENT
# Verify R_ARM_LDC_PC_G1 relocation is correctly applied for both positive
# and negative PC-relative offsets.
#
# Positive:
#   X = +0x1234
#   G1 residual = 0x34
#   imm8 = 0x34 >> 2 = 0x0d
#   U = 1
#   0xed9f0100 -> 0xed9f010d
#
# Negative:
#   X = -0x1234
#   G1 residual = 0x34
#   imm8 = 0x34 >> 2 = 0x0d
#   U = 0
#   0xed9f0100 -> 0xed1f010d
#END_COMMENT
#START_TEST
RUN: %clangas -c %p/Inputs/main.s -o %t.pos.o
RUN: %link %linkopts -march arm -static %t.pos.o -o %t.pos.out
RUN: %readelf -x .text %t.pos.out | %filecheck %s --check-prefix=POSITIVE

POSITIVE: 00000000 0d019fed 1eff2fe1

RUN: %clangas -c %p/Inputs/negative.s -o %t.neg.o
RUN: %link %linkopts -march arm -static %t.neg.o -o %t.neg.out
RUN: %readelf -x .text %t.neg.out | %filecheck %s --check-prefix=NEGATIVE

NEGATIVE: 00001230 00000000 0d011fed 1eff2fe1
#END_TEST
