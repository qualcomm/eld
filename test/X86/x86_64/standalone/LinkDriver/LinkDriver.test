#---LinkDriver.test--------------------- Executable------------------#
#BEGIN_COMMENT
# The X86 family hooks should invoke the existing x86_64 emulation and backend
# for both inferred and explicitly selected x86_64 links.
#--------------------------------------------------------------------
#END_COMMENT
#
RUN: %clang -target x86_64 -c %p/Inputs/1.c -o %t1.o
RUN: %link %linkopts %t1.o -o %t1.inferred.out
RUN: %readelf -h %t1.inferred.out | %filecheck %s --check-prefix=INFERRED
RUN: %link %linkopts %emulation %t1.o -o %t1.explicit.out
RUN: %readelf -h %t1.explicit.out | %filecheck %s --check-prefix=EXPLICIT

INFERRED: Class:                              ELF64
INFERRED: Machine: {{.*}}X86-64
EXPLICIT: Class:                              ELF64
EXPLICIT: Machine: {{.*}}X86-64
