REQUIRES: symbol_versioning, linux
# An old non-default GLOBAL mixed@V1 and the default GLOBAL mixed@@V2
# share input storage. The old version must receive its own COPY, while
# mixed@@V2 and other@@V2 must share one COPY and the same runtime address.
RUN: %clang %clangopts -fPIC -c %p/Inputs/alias-mixed-global-lib.c -o %t.lib.o
RUN: %link %linkopts -shared %t.lib.o --version-script=%p/Inputs/alias-mixed-global.map -o %t.lib.so
RUN: %clang %clangopts -O0 -fno-pic -fno-pie -c %p/Inputs/alias-mixed-global-main.c -o %t.main.o
RUN: %clang %clangopts -fuse-ld=%link -no-pie %t.main.o %t.lib.so -Wl,-rpath,$ORIGIN -o %t.out
RUN: %readelf -Wr %t.out | grep 'R_X86_64_COPY' | %filecheck %s --check-prefix=COPY
RUN: %readelf -Wr %t.out | grep -c 'R_X86_64_COPY' | %filecheck %s --check-prefix=COUNT
# Count version-qualified symbols, normalizing @@ from nm/readelf.
RUN: %readelf --dyn-syms %t.out | %python -c "import sys; rows=[s.split() for s in sys.stdin if s.split()]; print(*[sum(any(tok.replace('@@','@')==name for tok in row) for row in rows) for name in ('mixed@V1', 'mixed@V2', 'other@V2')])" | %filecheck %s --check-prefix=NUMSYM
RUN: %t.out
COPY-DAG: R_X86_64_COPY{{.*}}mixed@V1
COPY-DAG: R_X86_64_COPY{{.*}}mixed@V2
COUNT: {{^2$}}

NUMSYM: {{^1 1 1$}}
