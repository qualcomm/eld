#--- 2.c
volatile int gbar = 3;
int bar() { return gbar; }

#--- 3.c
volatile int gbaz = 5;
int baz() { return gbaz; }

#--- script.t
SECTIONS {
  .text : { *(*.text*) }
  .sdata : { *(*.sdata*) }
  .data : { *(*.data*) }
}
