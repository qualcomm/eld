UNSUPPORTED: ndk-build

# PT_TLS FileSiz includes initialized .tdata only; .tbss contributes to MemSiz
# but occupies no file space, including when PHDRS are explicit.

RUN: %clang %clangopts -c %p/Inputs/1.c -o %t1.o %clangg0opts
RUN: %link %linkopts -T %p/Inputs/script.t %t1.o -o %t1.out --defsym __aeabi_read_tp=0
RUN: %readelf -l -W %t1.out | %filecheck %s

# CHECK: TLS {{[x0-9a-f]+}} {{[x0-9a-f]+}} {{[x0-9a-f]+}} 0x{{[0]+}}4 0x{{[0]+}}8 R
