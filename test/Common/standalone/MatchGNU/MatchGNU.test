#---MatchGNU.test--------------------- Executable------------------#
#BEGIN_COMMENT
# This test checks the default match-gnu behavior and --script-options=match-llvm option.
#END_COMMENT
RUN: %rm %t1.lib1.a
RUN: %clang %clangopts -o %t1.1.o %p/Inputs/1.c -c -ffunction-sections
RUN: %clang %clangopts -o %t1.2.o %p/Inputs/2.c -c -ffunction-sections
RUN: %ar cr %aropts %t1.lib1.a %t1.1.o
RUN: %link -MapStyle txt %linkopts -o %t1.2.out %t1.2.o %t1.lib1.a -T %p/Inputs/script.t -Map %t1.2.map.txt
RUN: %filecheck %s --check-prefix=GNU < %t1.2.map.txt
RUN: %link -MapStyle txt %linkopts -o %t1.2.MatchLLVM.out %t1.2.o %t1.lib1.a -T %p/Inputs/script.t --script-options=match-llvm -Map %t1.2.MatchLLVM.map.txt
RUN: %filecheck %s --check-prefix=LLVM < %t1.2.MatchLLVM.map.txt
RUN: %not %link %linkopts -o /dev/null %t1.2.o %t1.lib1.a -T %p/Inputs/script.t --script-options=match-gnu 2>&1 | %filecheck %s --check-prefix=ERR

LLVM: # Output Section and Layout
LLVM: FOO
LLVM: *lib1*(*foo*)
LLVM-NEXT: .text.foo


GNU: # Output Section and Layout
GNU: .text.foo
GNU: *(.text.foo)
GNU-NEXT: .text.foo

ERR: script-options can only take options match-llvm


