REQUIRES: x86_64, linux
#UNSUPPORTED: windows, darwin
#---alias-size-data-copy.test-------------Copy Relocations-------------------#
#BEGIN_COMMENT
# `small` (1 byte) and `big` (8 bytes) start at the same address. The
# executable only references `small`, but the copy must be as large as the
# largest alias and the COPY relocation must name it: the dynamic loader
# copies min(st_size) bytes, so a COPY against `small` leaves `big` truncated
# for the library.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/alias-size-data-lib.s -o %t.lib.o
RUN: %link %linkopts -shared %t.lib.o -o %t.lib.so
RUN: %clang %clangopts -c -fno-pic -fno-pie %p/Inputs/alias-size-data-main.c -o %t.main.o
RUN: %clang %clangopts -fuse-ld=%link -no-pie %t.main.o %t.lib.so -o %t.out
RUN: %readelf -r %t.out | %filecheck %s --check-prefix=RELOC
RUN: %readelf --dyn-syms %t.out | %filecheck %s --check-prefix=SYMS
# Keep both different-sized names unique in .dynsym.
RUN: %nm -D --defined-only %t.out | grep -Ec '[[:space:]]small$' | %filecheck %s --check-prefix=ONE
RUN: %nm -D --defined-only %t.out | grep -Ec '[[:space:]]big$' | %filecheck %s --check-prefix=ONE
RUN: %readelf -r %t.out | grep -Ec 'R_X86_64_COPY([[:space:]]|$)' | %filecheck %s --check-prefix=ONE
RUN: %run_and_print_exit %t.out | %filecheck %s --check-prefix=EXEC
#END_TEST

RELOC: R_X86_64_COPY {{.*}} big
RELOC-NOT: R_X86_64_COPY

SYMS-DAG: {{[0-9a-f]+}} 1 OBJECT {{.*}} small
SYMS-DAG: {{[0-9a-f]+}} 8 OBJECT {{.*}} big

EXEC-NOT: FAIL:
EXEC: PASSED
EXEC-NEXT: {{^}}0

ONE: {{^1$}}
