UNSUPPORTED: windows, darwin, ndk-build
#BEGIN_COMMENT
# ELF aliases may share an address but have different st_size values.
# Only small_alias (1 byte) is referenced by the executable.
# The COPY relocation must use full_alias (16 bytes) as its owner.
# Both symbols must resolve to the same output storage.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c -fPIC %p/Inputs/size-lib.s -o %t.lib.o
RUN: %link %linkopts -shared %t.lib.o -o %t.lib.so
RUN: %clang %clangopts -c -fno-pic -fno-pie %p/Inputs/size-main.c -o %t.main.o
RUN: %link %linkopts %t.main.o -Bdynamic %t.lib.so -o %t.out
RUN: %readelf -r %t.out | %filecheck %s --check-prefix=RELOC
RUN: %readelf -r %t.out | grep -Ec 'R_[A-Za-z0-9_]+_COPY' | %filecheck %s --check-prefix=COUNT
RUN: %readelf --dyn-syms --wide %t.out | %filecheck %s --check-prefix=SIZE
RUN: %nm -D --defined-only %t.out | grep -E ' (full_alias|small_alias)$' | sort | %filecheck %s --check-prefix=ALIAS
#END_TEST

RELOC: {{R_[A-Z0-9_]+_COPY}}{{.*}}full_alias

COUNT: {{^1$}}

SIZE-DAG: {{[[:space:]]1[[:space:]]+OBJECT.*small_alias}}
SIZE-DAG: {{[[:space:]]16[[:space:]]+OBJECT.*full_alias}}

ALIAS: [[ADDR:[0-9a-f]+]] {{[BbDd]}} full_alias
ALIAS-NEXT: [[ADDR]] {{[BbDd]}} small_alias
