#---EmitOnFailure.test--------------------- Executable ----------------------#
#BEGIN_COMMENT
# This test checks that the symbol resolution report is emitted even when the
# link fails after symbol resolution.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -o %t1.o %p/Inputs/1.c -c
RUN: %not %link %linkopts -o %t1.out %t1.o --emit-symbol-resolution-report %t1.json
RUN: %python %eld_src_tools_root/SymbolResolutionInspector/SymbolResolutionInspector.py %t1.json --symbol '^missing$' | %filecheck %s
#END_TEST

CHECK: missing
