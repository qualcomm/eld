#---OverlaySharedVmaLmaEmpty.test----------- Executable,LS------------------#
# Empty OVERLAY

RUN: %clang %clangopts -c %p/Inputs/input.s -o %t.o
RUN: %link %linkopts %t.o -o %t.elf -T %p/Inputs/overlay_empty.lds
RUN: %readelf -S %t.elf | %filecheck %s

