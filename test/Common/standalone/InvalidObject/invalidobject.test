#---invalidobject.test--------------------------- Executable -----------------#
#BEGIN_COMMENT
# This tests that the linker errors when there is an executable
# given as input.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/a.c -o %t1.o
RUN: %link %linkopts %t1.o -o %t2 --no-emit-relocs
RUN: %not %link -o %t1.out %linkopts %t2 2>&1 | %filecheck %s
#END_TEST

#CHECK: Error: executable input file {{.*}} can only be used with --just-symbols
