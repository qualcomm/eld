#---LTOPathSpecialCharacters.test-------------------- Executable --------------#
#BEGIN_COMMENT
# Verify an LTO input path with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c -flto %p/Inputs/1.c -o "%t.bitcode's @input.o"
RUN: %link %linkopts "%t.bitcode's @input.o" -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -h replay.out | %filecheck %s

CHECK: ELF Header:
RESPONSE: "{{.*}}bitcode's @input.o{{.*}}"
#END_TEST
#UNSUPPORTED: windows, ndk-build, x86, riscv32, riscv64
