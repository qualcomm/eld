#UNSUPPORTED: windows
#---ReplayEqualsForm.test------------------ Executable --------------------#
#BEGIN_COMMENT
# Verify --replay=<tarfile> form works the same as --replay <tarfile>.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %link %linkopts --no-default-plugins %t.1.o -T %p/Inputs/1.script.t -o %t.orig.out --reproduce %t.repro.tar
RUN: %link %linkopts --replay=%t.repro.tar -o %t.replay.out
RUN: %diff %t.orig.out %t.replay.out
#END_TEST
