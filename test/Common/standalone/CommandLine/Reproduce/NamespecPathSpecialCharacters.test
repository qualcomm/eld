#---NamespecPathSpecialCharacters.test-------------- Executable ---------------#
#BEGIN_COMMENT
# Verify an archive namespec with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.foo.o
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.main.o
RUN: %mkdir "%t.lib dir"
RUN: %ar -cr "%t.lib dir/libfoo's @archive.a" %t.foo.o
RUN: %link %linkopts %t.main.o -L "%t.lib dir" "-l:libfoo's @archive.a" -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: foo
RESPONSE: "{{.*}}libfoo's @archive.a{{.*}}"
#END_TEST
