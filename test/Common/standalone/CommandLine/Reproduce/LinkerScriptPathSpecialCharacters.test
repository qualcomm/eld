#---LinkerScriptPathSpecialCharacters.test---------- Executable ---------------#
#BEGIN_COMMENT
# Verify a linker script path with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.input.o
RUN: %cp %p/Inputs/1.script.t "%t.linker @script's.t"
RUN: %link %linkopts %t.input.o -T "%t.linker @script's.t" -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: foo
RESPONSE: -T "{{.*}}linker @script's.t{{.*}}"
#END_TEST
