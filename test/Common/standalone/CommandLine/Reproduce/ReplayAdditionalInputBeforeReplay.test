#UNSUPPORTED: windows
#---ReplayAdditionalInputBeforeReplay.test--- Executable -----------------#
#BEGIN_COMMENT
# Verify --replay accepts additional user-provided input files placed before
# the replay option in the command line.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.2.o
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.extra.o
RUN: %link %linkopts --no-default-plugins %t.2.o %t.1.o -o %t.orig.out --reproduce %t.repro.tar
RUN: %link %linkopts %t.extra.o --replay %t.repro.tar --allow-multiple-definition -o %t.replay.out
RUN: %readelf -h %t.replay.out 2>&1 | %filecheck %s

CHECK: ELF Header:
#END_TEST
