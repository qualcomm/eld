#---NoReuseTrampolinesOptionForm.test----- Executable -------------------------#
#BEGIN_COMMENT
# Verify reproduce preserves the joined --no-reuse-trampolines-file= alias.
#END_COMMENT
#START_TEST
RUN: %echo "{ foo; }" > %t.no-reuse-trampolines
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %not %link %linkopts --no-default-plugins %t.1.o -l1 --no-reuse-trampolines-file=%t.no-reuse-trampolines -o %t.out --reproduce %t.repro.tar
RUN: %mkdir %t.repro
RUN: cd %t.repro
RUN: %tar %gnutaropts -xf %t.repro.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < %t.repro/response.txt

RESPONSE: --no-reuse-trampolines-file={{[^ ]+}}
#END_TEST
