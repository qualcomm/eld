#UNSUPPORTED: windows
#---ReplayResponseFileArgument.test--------- Executable ------------------#
#BEGIN_COMMENT
# Verify --replay works when the replay invocation is supplied through a
# response file.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %link %linkopts --no-default-plugins %t.1.o -o %t.orig.out --reproduce %t.repro.tar
RUN: %echo "--replay %t.repro.tar -o %t.replay.out" > %t.replay.rsp
RUN: %link %linkopts @%t.replay.rsp
RUN: %readelf -h %t.replay.out 2>&1 | %filecheck %s

#CHECK: ELF Header:
#END_TEST
