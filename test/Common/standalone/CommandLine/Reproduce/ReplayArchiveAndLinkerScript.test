#UNSUPPORTED: windows
#---ReplayArchiveAndLinkerScript.test------------------- Executable -------#
#BEGIN_COMMENT
# Verify --replay can rebuild from a reproduce tarball that contains both an
# archive input and a linker script input.
#END_COMMENT
#START_TEST
RUN: %rm %t.lib.a %t.repro.tar
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.2.o
RUN: %ar -cr %aropts %t.lib.a %t.1.o
RUN: %link %linkopts --no-default-plugins -T %p/Inputs/script1.t %t.2.o %t.lib.a -o %t.orig.out --reproduce %t.repro.tar
RUN: %tar -tf %t.repro.tar | %filecheck %s --check-prefix=TAR
RUN: %link %linkopts --replay %t.repro.tar -o %t.replay.out
RUN: %diff %t.orig.out %t.replay.out

TAR-DAG: LinkerScript/
TAR-DAG: Archives/
#END_TEST
