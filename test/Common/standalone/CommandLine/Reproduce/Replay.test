#UNSUPPORTED: windows
#---Replay.test---------------------------- Executable --------------------#
#BEGIN_COMMENT
# Verify --replay can rebuild from a reproduce tarball and allow extra options.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t1.1.o
RUN: %link %linkopts --no-default-plugins %t1.1.o -T %p/Inputs/1.script.t -o %t1.orig.out --reproduce %t1.repro.tar
RUN: %link %linkopts --replay %t1.repro.tar -o %t1.replay.out
RUN: %readelf -h %t1.replay.out 2>&1 | %filecheck %s

#CHECK: ELF Header:
#END_TEST
