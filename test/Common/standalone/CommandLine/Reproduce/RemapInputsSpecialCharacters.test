#---RemapInputsSpecialCharacters.test----------------- Executable -------------#
#BEGIN_COMMENT
# Verify that --remap-inputs preserves spaces and apostrophes in its paths.
#END_COMMENT

#START_TEST
RUN: %clang %clangopts -c %p/Inputs/remap-main.c -o %t.main.o
RUN: %clang %clangopts -c %p/Inputs/remap-foo.c -o "%t foo's input.o"
RUN: %clang %clangopts -c %p/Inputs/remap-bar.c -o "%t bar's input.o"
RUN: %echo "INPUT(\"%t foo's input.o\")" > %t.input.t

RUN: %link %linkopts -o %t.original.out --remap-inputs="%t foo's input.o=%t bar's input.o" %t.main.o -T %t.input.t --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: FILE    LOCAL  DEFAULT   ABS remap-bar.c
CHECK-NOT: remap-foo.c
#END_TEST