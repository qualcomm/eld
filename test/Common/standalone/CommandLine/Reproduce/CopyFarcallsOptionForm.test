#---CopyFarcallsOptionForm.test----------- Executable -------------------------#
#BEGIN_COMMENT
# Verify reproduce preserves the joined --copy-farcalls-from-file= alias.
#END_COMMENT
#START_TEST
RUN: %echo "{ foo; }" > %t.copy-farcalls
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %not %link %linkopts --no-default-plugins %t.1.o -l1 --copy-farcalls-from-file=%t.copy-farcalls -o %t.out --reproduce %t.repro.tar
RUN: %mkdir %t.repro
RUN: cd %t.repro
RUN: %tar %gnutaropts -xf %t.repro.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < %t.repro/response.txt

RESPONSE: --copy-farcalls-from-file={{[^ ]+}}
#END_TEST
