#---JustSymbolsPathSpecialCharacters.test----------- Executable ---------------#
#BEGIN_COMMENT
# Verify a just-symbols input path with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.main.o
RUN: %clang %clangopts -c %p/Inputs/1.c -o "%t.symbols @object's.o"
RUN: %link %linkopts %t.main.o -R "%t.symbols @object's.o" -e main -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: foo
RESPONSE: -R "{{.*}}symbols @object's.o{{.*}}"
#END_TEST
