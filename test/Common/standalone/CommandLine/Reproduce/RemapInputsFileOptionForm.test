#---RemapInputsFileOptionForm.test-------- Executable -------------------------#
#BEGIN_COMMENT
# Verify reproduce preserves the joined --remap-inputs-file= form.
#END_COMMENT
#START_TEST
RUN: %echo "unused=unused" > %t.remap
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %not %link %linkopts --no-default-plugins %t.1.o -l1 --remap-inputs-file=%t.remap -o %t.out --reproduce %t.repro.tar
RUN: %mkdir %t.repro
RUN: cd %t.repro
RUN: %tar %gnutaropts -xf %t.repro.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < %t.repro/response.txt

RESPONSE: --remap-inputs-file={{[^ ]+}}
#END_TEST
