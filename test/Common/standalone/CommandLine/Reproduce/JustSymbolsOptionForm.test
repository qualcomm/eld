#---JustSymbolsOptionForm.test------------ Executable -------------------------#
#BEGIN_COMMENT
# Verify reproduce preserves the joined -R= just-symbols alias.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o
RUN: %not %link %linkopts --no-default-plugins %t.1.o -l1 -R=%t.1.o -o %t.out --reproduce %t.repro.tar
RUN: %mkdir %t.repro
RUN: cd %t.repro
RUN: %tar %gnutaropts -xf %t.repro.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < %t.repro/response.txt

RESPONSE: -R={{[^ ]+}}
#END_TEST
