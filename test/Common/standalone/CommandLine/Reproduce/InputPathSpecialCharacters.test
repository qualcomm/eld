#---InputPathSpecialCharacters.test----------------- Executable ---------------#
#BEGIN_COMMENT
# Verify an object input path with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o "%t.input's @object.o"
RUN: %link %linkopts "%t.input's @object.o" -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: foo
RESPONSE: "{{.*}}input's @object.o{{.*}}"
#END_TEST
