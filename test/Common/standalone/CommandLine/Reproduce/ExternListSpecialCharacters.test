#---ExternListSpecialCharacters.test------------ Executable -------------------#
#BEGIN_COMMENT
# Verify an extern list path with spaces and a quote survives replay.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.input.o
RUN: %cp %p/Inputs/externlist "%t.extern @list's.txt"
RUN: %link %linkopts %t.input.o --extern-list="%t.extern @list's.txt" -o %t.original.out --reproduce %t.tar
RUN: %mkdir %t.replay
RUN: cd %t.replay
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %filecheck %s --check-prefix=RESPONSE < response.txt
RUN: %link @response.txt -o replay.out
RUN: %readelf -s replay.out | %filecheck %s

CHECK: foo
RESPONSE: --extern-list "{{.*}}extern @list's.txt{{.*}}"
#END_TEST
