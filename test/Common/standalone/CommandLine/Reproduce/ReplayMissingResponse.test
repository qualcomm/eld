#UNSUPPORTED: windows
#---ReplayMissingResponse.test-------------- Executable -------------------#
#BEGIN_COMMENT
# Verify --replay fails when tarball does not contain response.txt.
#END_COMMENT
#START_TEST
RUN: %mkdir %t.empty
RUN: %tar -cf %t.empty.tar -C %t.empty .
RUN: %not %link %linkopts --replay %t.empty.tar -o %t.out 2>&1 | %filecheck %s

CHECK: error: replay tarball is missing or invalid response.txt:
#END_TEST
