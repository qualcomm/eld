#---ExcludeLibsDuplicateBasenamesReplay.test-------- Executable------------------#
#BEGIN_COMMENT
# Verify one exclusion rewrites to every captured archive with the same basename.
#END_COMMENT
#-------------------------------------------------------------------------------
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o -fPIC
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.2.o -fPIC
RUN: %clang %clangopts -c %p/Inputs/3.c -o %t.3.o -fPIC
RUN: mkdir -p %t.dup1 %t.dup2
RUN: %ar -cr %t.dup1/libdup.a %t.2.o
RUN: %ar -cr %t.dup2/libdup.a %t.3.o
RUN: %link %linkopts -shared %t.1.o --whole-archive %t.dup1/libdup.a %t.dup2/libdup.a --no-whole-archive --exclude-libs libdup.a -o %t.out --reproduce %t.tar
RUN: %readelf --dyn-symbols %t.out | %filecheck %s --check-prefix=DUPLICATE
RUN: %mkdir %t.reproduce
RUN: cd %t.reproduce
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %link @response.txt -o reproduce.out
RUN: %readelf --dyn-symbols %t.reproduce/reproduce.out | %filecheck %s --check-prefix=DUPLICATE
#END_TEST

#DUPLICATE-NOT: foo
#DUPLICATE-NOT: bar
