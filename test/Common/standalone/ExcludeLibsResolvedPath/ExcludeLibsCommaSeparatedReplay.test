#---ExcludeLibsCommaSeparatedReplay.test------------- Executable------------------#
#BEGIN_COMMENT
# Verify comma-separated archive exclusions survive replay for literal namespecs.
#END_COMMENT
#-------------------------------------------------------------------------------
#START_TEST
RUN: %clang %clangopts -c %p/Inputs/1.c -o %t.1.o -fPIC
RUN: %clang %clangopts -c %p/Inputs/2.c -o %t.2.o -fPIC
RUN: %clang %clangopts -c %p/Inputs/3.c -o %t.3.o -fPIC
RUN: mkdir -p %t.2 %t.3
RUN: %ar -cr %t.2/lib2.a %t.2.o
RUN: %ar -cr %t.3/lib3.a %t.3.o
RUN: %link %linkopts -shared %t.1.o --whole-archive -L %t.2 -L %t.3 -l:lib2.a -l:lib3.a --no-whole-archive --exclude-libs lib2.a,lib3.a -o %t.out --reproduce %t.tar
RUN: %mkdir %t.reproduce
RUN: cd %t.reproduce
RUN: %tar %gnutaropts -xf %t.tar --strip-components=1
RUN: %link @response.txt -o reproduce.out
RUN: %readelf --dyn-symbols %t.reproduce/reproduce.out | %filecheck %s
#END_TEST

#CHECK-NOT: foo
#CHECK-NOT: bar
