# REQUIRES: hexagon || arm || aarch64 || riscv32 || riscv64
# Claim section-symbol uses before merging; preserve their metadata and bytes.
# Unclaimed references must still be retargeted, including interior offsets.
# ELD does not merge constant pools; also check unchanged constant uses.
RUN: %clang %clangopts -c %p/Inputs/merging.c -o %t.one.o
RUN: %clang %clangopts -DSECOND -c %p/Inputs/merging.c -o %t.two.o
RUN: %link %linkopts --emit-relocs --trace-merge-strings=all %t.one.o %t.two.o -T %p/Inputs/merging.t -L%libsdir -L%libsdir/test --plugin-config %p/Inputs/MergingConfig.yaml -o %t.out > %t.log 2>&1
RUN: %filecheck %s --check-prefix=COUNT --input-file=%t.log
RUN: %filecheck %s --check-prefix=TRACE --input-file=%t.log --implicit-check-not="Modified relocation{{.*}}.data.claimed"
RUN: %python %p/Inputs/check_merging.py --readelf %readelf --image %t.out
# Without SHF_MERGE, both original copies remain and the claims still work.
RUN: %clang %clangopts -DNO_MERGE -c %p/Inputs/merging.c -o %t.one.no-merge.o
RUN: %clang %clangopts -DNO_MERGE -DSECOND -c %p/Inputs/merging.c -o %t.two.no-merge.o
RUN: %link %linkopts --emit-relocs %t.one.no-merge.o %t.two.no-merge.o -T %p/Inputs/merging.t -L%libsdir -L%libsdir/test --plugin-config %p/Inputs/MergingConfig.yaml -o %t.no-merge.out > %t.no-merge.log 2>&1
RUN: %filecheck %s --check-prefix=COUNT --input-file=%t.no-merge.log
RUN: %python %p/Inputs/check_merging.py --readelf %readelf --image %t.no-merge.out --no-merge
COUNT: claimed merge uses: 4
TRACE-DAG: Modified relocation .rodata.claim.str{{.*}}.data.control
