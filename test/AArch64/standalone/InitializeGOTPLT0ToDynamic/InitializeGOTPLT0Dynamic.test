#---InitializeGOTPLT0Dynamic.test------------------------------------------#
#BEGIN_COMMENT
# Verify that a GOT reference to _DYNAMIC is placed in .got without
# creating an unnecessary .got.plt section.
#END_COMMENT
#START_TEST
RUN: %clang %clangopts -target aarch64 -c %p/Inputs/1.c -o %t1.1.o %clangg0opts -fPIC
RUN: %link %linkopts -march aarch64 -shared %t1.1.o -o %t1.lib1.so -z max-page-size=0x1000
RUN: %readelf -SW %t1.lib1.so | %filecheck %s

#CHECK: .got              PROGBITS
#CHECK-NOT: .got.plt
#END_TEST
